{
  "database": "Zotero",
  "noteImportFolder": "Zotero/Notes",
  "pdfExportImageDPI": 120,
  "pdfExportImageFormat": "jpg",
  "pdfExportImageQuality": 90,
  "citeFormats": [
    {
      "name": "Chicago Short Note",
      "format": "formatted-citation",
      "cslStyle": "chicago-note-bibliography"
    },
    {
      "name": "Chicago Full Note",
      "format": "formatted-citation",
      "cslStyle": "chicago-fullnote-bibliography"
    }
  ],
  "exportFormats": [
    {
      "name": "Create Source Record",
      "outputPathTemplate": "Zotero/Highlights/{{citekey}}.md",
      "imageOutputPathTemplate": "Attachments/Images/Zotero/{{citekey}}",
      "imageBaseNameTemplate": "image",
      "templatePath": "Zotero/Templates/Source Record Template.md",
      "cslStyle": "chicago-fullnote-bibliography"
    },
    {
      "name": "Import Highlights",
      "outputPathTemplate": "Zotero/Highlights/{{citekey}}.md",
      "imageOutputPathTemplate": "Attachments/Images/Zotero/{{citekey}}",
      "imageBaseNameTemplate": "image",
      "templatePath": "Zotero/Templates/Zotero Template.md",
      "cslStyle": "chicago-fullnote-bibliography"
    }
  ],
  "citeSuggestTemplate": "[[{{citekey}}]]",
  "openNoteAfterImport": false,
  "whichNotesToOpenAfterImport": "first-imported-note",
  "pdfExportImageOCR": false,
  "pdfExportImageOCRLang": "eng",
  "pdfExportImageTessDataDir": "",
  "pdfExportImageTesseractPath": ""
}
